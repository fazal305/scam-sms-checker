{
  "name": "scam-sms-checker",
  "private": true,
  "version": "1.0.0",
  "description": "An Urdu-first web app that tells Pakistani parents in one tap whether an SMS (fake BISP payments, prize draws, blocked JazzCash/Easypaisa accounts) is a scam, with a spoken Urdu warning and a WhatsApp alert for the family. All checks run on the phone.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "playwright test",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
